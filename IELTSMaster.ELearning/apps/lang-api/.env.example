# Sao chép thành `.env` khi dev local. Production truyền biến qua env_file của docker compose.

NODE_ENV=development
PORT=3101

# Dev dùng database riêng `lang-simulator` trên Postgres của VPS (≥ 13).
# Lấy host/mật khẩu từ người quản trị, không ghi giá trị thật vào file này.
DB_HOST=
DB_PORT=5432
DB_USERNAME=lang_simulator
DB_PASSWORD=
DB_NAME=lang-simulator
DB_SCHEMA=public
DB_LOGGING=false

# Bắt buộc, tối thiểu 32 ký tự. Tạo bằng: openssl rand -base64 48
JWT_SECRET=

# Thời hạn access token (JWT) và refresh token (cookie ls_rt), dạng <số><s|m|h|d>.
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_EXPIRES_IN=30d
# true khi chạy HTTPS; VPS hiện dùng HTTP nên để false.
COOKIE_SECURE=false

# Cloudflare R2 – upload media của đề và logo trung tâm. Không bắt buộc: thiếu
# bất kỳ biến nào thì API vẫn chạy nhưng endpoint upload trả 501.
# Tạo API token riêng cho dự án (Object Read & Write, giới hạn đúng 2 bucket dưới đây).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Bucket bật public access (ảnh/audio/video của đề, logo trung tâm).
R2_PUBLIC_BUCKET=lang-simulator-public
# URL công khai của chính bucket public: https://pub-<id>.r2.dev hoặc custom domain (không có / ở cuối).
R2_PUBLIC_BASE_URL=
# Bucket tắt public access (ghi âm của học viên, chỉ đọc qua presigned URL – Step 13).
R2_PRIVATE_BUCKET=lang-simulator-private

# Gemini – "Định dạng bằng AI" trong trình soạn đề. Không bắt buộc: thiếu cấu hình
# thì nút AI bị disable và route AI trả 501, phần còn lại của API vẫn chạy.
# GEMINI_BACKEND: vertex (service account GCP, cần role Vertex AI User + bật API
# aiplatform.googleapis.com) hoặc aistudio (API key). Bỏ trống = tự chọn.
GEMINI_BACKEND=vertex
GEMINI_MODEL=gemini-3.6-flash
GEMINI_MAX_OUTPUT_TOKENS=16384
GEMINI_VERTEX_LOCATION=global
GCP_PROJECT_ID=
# Máy dev: đường dẫn file JSON service account (đặt trong apps/lang-api/secrets/, đã gitignore).
GOOGLE_APPLICATION_CREDENTIALS=secrets/gcp-service-account.json
# Hoặc nội dung JSON mã hoá base64 (ưu tiên hơn đường dẫn file): base64 -i key.json | tr -d '\n'
GCP_SERVICE_ACCOUNT_JSON_BASE64=
# Chỉ dùng khi GEMINI_BACKEND=aistudio.
GEMINI_API_KEY=

# Chỉ dùng cho `pnpm --filter lang-api seed:owner` (tạo System Owner đầu tiên, chạy lại không tạo trùng).
# Database dùng chung nên chỉ chạy một lần từ máy dev. Seed xong nên xoá SEED_OWNER_PASSWORD.
SEED_OWNER_EMAIL=
SEED_OWNER_PASSWORD=
SEED_OWNER_NAME=
# YYYY-MM-DD
SEED_OWNER_DOB=
