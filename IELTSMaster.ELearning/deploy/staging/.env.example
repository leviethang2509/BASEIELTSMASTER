# Staging (VPS 2): đặt tại /opt/lang-simulator/.env (chmod 600). Không commit file thật.
# Dùng cho cả docker compose (DB_*, IMAGE_TAG, APP_PORT) và biến môi trường của container app.

# ---- Docker ----
# Workflow "Deploy Staging" tự ghi dòng này (sha-<commit> vừa deploy); rollback cũng qua workflow.
IMAGE_TAG=
# Cổng trên host cho lang-app, bỏ trống = 3000.
APP_PORT=3000
# Cổng Postgres trên 127.0.0.1 của VPS (chỉ để SSH tunnel), bỏ trống = 5432.
# Đổi (vd. 15432) nếu 5432 đã có Postgres khác chiếm.
DB_PUBLISH_PORT=5432

# ---- Database (container Postgres trong cùng compose) ----
# DB_HOST/DB_PORT do docker-compose.yml đặt sẵn (service `db`), không cần khai báo.
# User/mật khẩu/database chỉ được tạo ở lần chạy đầu (volume trống).
DB_USERNAME=lang_simulator
# Tạo bằng: openssl rand -hex 24 (chỉ chữ số + a-f, tránh ký tự đặc biệt)
DB_PASSWORD=
DB_NAME=lang-simulator
DB_SCHEMA=public
DB_LOGGING=false

# ---- lang-api ----
NODE_ENV=production

# Bắt buộc, tối thiểu 32 ký tự, khác máy dev và VPS 1. Tạo bằng: openssl rand -base64 48
JWT_SECRET=

JWT_ACCESS_EXPIRES_IN=15m
REFRESH_EXPIRES_IN=30d
# Đổi thành true khi có domain + HTTPS.
COOKIE_SECURE=false

# Cloudflare R2. Thiếu thì upload media/ghi âm trả 501.
# Nên dùng 2 bucket + API token riêng cho staging; dùng chung bucket với dev cũng
# chạy được (key theo id tenant/user nên không đè nhau).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BUCKET=
R2_PUBLIC_BASE_URL=
R2_PRIVATE_BUCKET=

# Gemini – "Định dạng bằng AI". Không bắt buộc: thiếu thì route AI trả 501.
# Trên VPS dùng GCP_SERVICE_ACCOUNT_JSON_BASE64 (không mount file):
#   base64 -i key.json | tr -d '\n'
GEMINI_BACKEND=vertex
GEMINI_MODEL=gemini-3.6-flash
GEMINI_MAX_OUTPUT_TOKENS=16384
GEMINI_VERTEX_LOCATION=global
GCP_PROJECT_ID=
GCP_SERVICE_ACCOUNT_JSON_BASE64=
# Chỉ dùng khi GEMINI_BACKEND=aistudio.
GEMINI_API_KEY=
