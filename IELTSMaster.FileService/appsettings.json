{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "PdfCache": {
    "CacheDirectoryName": "_office_pdf_cache",
    "RetentionMonths": 6,
    "CleanupIntervalHours": 24,
    "ConversionTimeoutSeconds": 60
  },
  "Storage": {
    "Provider": "Local",
    "Local": {
      "BaseFolder": "Files",
      "PublicBaseUrl": "http://localhost:5004"
    },
    "R2": {
      "AccountId": "",
      "AccessKeyId": "",
      "SecretAccessKey": "",
      "PublicBucket": "ielts-master-public",
      "PublicBaseUrl": "https://pub-xxx.r2.dev",
      "PrivateBucket": "ielts-master-private",
      "PresignedUrlTtlSeconds": 600
    }
  }
}
