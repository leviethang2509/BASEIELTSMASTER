# Đặt trên VPS tại /opt/lang-simulator/.env (chmod 600). Không commit file thật.
# Dùng cho cả docker compose (DB_NETWORK, IMAGE_TAG) và biến môi trường của container.

# ---- Docker ----
# Network mà container PostgreSQL đang tham gia. Xem bằng:
#   docker inspect -f '{{range $k, $v := .NetworkSettings.Networks}}{{$k}} {{end}}' <ten-container-postgres>
DB_NETWORK=
# Tag image cần chạy, bỏ trống = latest. Rollback: IMAGE_TAG=sha-<commit đầy đủ>
IMAGE_TAG=

# ---- lang-api ----
NODE_ENV=production

# Tên container PostgreSQL (cùng network nên dùng tên thay cho IP)
DB_HOST=
DB_PORT=5432
DB_USERNAME=lang_simulator
DB_PASSWORD=
DB_NAME=lang-simulator
DB_SCHEMA=public
DB_LOGGING=false

# Bắt buộc, tối thiểu 32 ký tự, khác giá trị ở máy dev. Tạo bằng: openssl rand -base64 48
JWT_SECRET=

# Không bắt buộc (đây là giá trị mặc định). Thời hạn access token / refresh token.
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_EXPIRES_IN=30d
# Đổi thành true khi có domain + HTTPS.
COOKIE_SECURE=false

# Cloudflare R2 – copy y nguyên 6 biến từ `apps/lang-api/.env` của máy dev
# (container dùng chung 2 bucket với dev). Thiếu thì upload media trả 501.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BUCKET=lang-simulator-public
R2_PUBLIC_BASE_URL=
R2_PRIVATE_BUCKET=lang-simulator-private

# Gemini – "Định dạng bằng AI". Không bắt buộc: thiếu thì route AI trả 501.
# Trên VPS dùng GCP_SERVICE_ACCOUNT_JSON_BASE64 (không mount file):
#   base64 -i key.json | tr -d '\n'
GEMINI_BACKEND=vertex
GEMINI_MODEL=gemini-3.6-flash
GEMINI_MAX_OUTPUT_TOKENS=16384
GEMINI_VERTEX_LOCATION=global
GCP_PROJECT_ID=
GCP_SERVICE_ACCOUNT_JSON_BASE64=
# Chỉ dùng khi GEMINI_BACKEND=aistudio.
GEMINI_API_KEY=
